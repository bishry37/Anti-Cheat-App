rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(data) {
      return isSignedIn() && data.adminId == request.auth.uid;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Auth tokens never contain custom claims in this environment.
    // Check if the user exists in the admins collection.
    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email.lower() == 'bishry37@gmail.com'
      );
    }

    // 3. Collection Rules
    
    // Admins Collection
    match /admins/{adminId} {
      allow get: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == adminId;
      allow update, delete: if isAdmin();
    }

    // Classes Collection
    match /classes/{classId} {
      allow read: if true; // Publicly readable for students to select class
      allow create: if isAdmin() && isOwner(incoming());
      allow update, delete: if isAdmin() && isOwner(existing());
    }

    // Settings Collection
    match /settings/{settingId} {
      allow read: if true;
      allow create: if isAdmin() && isOwner(incoming()) && settingId == request.auth.uid;
      allow update: if isAdmin() && isOwner(existing()) && settingId == request.auth.uid;
    }

    // Subjects Collection
    match /subjects/{subjectId} {
      allow read: if true;
      allow create: if isAdmin() && isOwner(incoming());
      allow update, delete: if isAdmin() && isOwner(existing());
    }

    // Audio Banks Collection
    match /audio_banks/{audioId} {
      allow read: if true;
      allow create: if isAdmin() && isOwner(incoming());
      allow update, delete: if isAdmin() && isOwner(existing());

      match /chunks/{chunkId} {
        allow read: if true;
        allow create, update, delete: if isAdmin();
      }
    }

    // Questions Collection
    match /questions/{questionId} {
      allow read: if true;
      allow create: if isAdmin() && isOwner(incoming());
      allow update, delete: if isAdmin() && isOwner(existing());
    }

    // Exams Collection
    match /exams/{examId} {
      allow read: if true;
      allow create: if isAdmin() && isOwner(incoming());
      allow update, delete: if isAdmin() && isOwner(existing());
    }

    // Student Sessions Collection
    match /student_sessions/{sessionId} {
      // Students can read and update their own session even if not authenticated via Firebase (anonymous fallback)
      allow get: if true;
      // Admins need to list sessions for their exams, students need to list to check existing sessions during login
      allow list: if (isAdmin() && resource.data.adminId == request.auth.uid) || !isAdmin();
      
      // Students create their own session
      allow create: if isValidId(sessionId);
      // Students update their progress, Admins update status/duration
      allow update: if true; 
      // Only admin can delete sessions
      allow delete: if isAdmin() && existing().adminId == request.auth.uid;
    }

    // Violations Collection
    match /violations/{violationId} {
      allow get: if true;
      // Admins list violations for their students
      allow list: if isAdmin() && resource.data.adminId == request.auth.uid;
      // Students can create violation logs
      allow create: if true;
      allow update, delete: if isAdmin() && existing().adminId == request.auth.uid;
    }
  }
}
